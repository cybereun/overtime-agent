{
  "name": "overtime-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "대화로 설정하는 초과근무 확인 알림",
  "author": "Overtime Agent",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-test.mjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "kr.overtime.agent",
    "productName": "초과근무",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "publish": [{"provider":"github","owner":"cybereun","repo":"overtime-agent","releaseType":"release"}],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Overtime-Agent-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
